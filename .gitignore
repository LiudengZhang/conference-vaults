# macOS
.DS_Store

# MkDocs build output
site/

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Editor / agent metadata
.claude/
.codex-output/

# Large binary artifacts
*.pdf
**/pdfs/

# Temporary / scratch
/_tmp/
/_scratch/
/_Temp/
/_baseline/

